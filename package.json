{
  "name": "pdfmonkey",
  "version": "0.0.0",
  "description": "Official PDFMonkey Node.js SDK — generate PDFs from HTML/CSS templates",
  "author": "PDFMonkey <support@pdfmonkey.io> (https://www.pdfmonkey.io)",
  "homepage": "https://github.com/pdfmonkey/pdfmonkey-node#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pdfmonkey/pdfmonkey-node.git"
  },
  "bugs": {
    "url": "https://github.com/pdfmonkey/pdfmonkey-node/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.3",
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "typecheck": "tsc --noEmit",
    "attw": "attw --pack .",
    "prepublishOnly": "pnpm run build && pnpm run typecheck && pnpm run attw"
  },
  "keywords": [
    "pdfmonkey",
    "pdf",
    "pdf-generation",
    "api",
    "sdk",
    "node",
    "typescript",
    "document",
    "html-to-pdf",
    "webhook"
  ],
  "license": "MIT",
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.2",
    "@biomejs/biome": "^2.4.13",
    "@changesets/cli": "^2.31.0",
    "@vitest/coverage-v8": "4.1.5",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
